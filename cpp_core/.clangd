# 子目录归类后仍用 #include "foo.h"；与 CMake target_include_directories 对齐。
CompileFlags:
  Add:
    - -I.
    - -Iapp
    - -Iconfig
    - -Iengine
    - -Icapture
    - -Iipc
    - -Ishell
    - -DWIN32
    - -D_WIN32
    - -DWIN32_LEAN_AND_MEAN
    - -DUNICODE
    - -D_UNICODE
    - -DNOMINMAX
    - -fms-compatibility
    - -fms-extensions
