{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build helper",
      "type": "shell",
      "command": "cmake --build . --config Release --target helper",
      "options": {
        "cwd": "${workspaceFolder}/cpp_core/build"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "run helper",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build helper"
      ],
      "type": "shell",
      "command": ".\\helper.exe",
      "options": {
        "cwd": "${workspaceFolder}/cpp_core/build/Release"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}